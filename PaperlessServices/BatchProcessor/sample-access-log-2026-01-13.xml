<?xml version="1.0" encoding="UTF-8"?>
<!-- 
  Access Log XML Format
  
  This file represents daily access statistics from external systems.
  
  Structure:
  - Root element: <AccessLog> with date attribute (YYYY-MM-DD format)
  - Child elements: <Document> with id and accessCount attributes
    - id: The document ID in the database
    - accessCount: Number of times this document was accessed on this date
  
  Example usage:
  This file should be placed in the configured input folder (e.g., /data/input/)
  with a filename matching the pattern (e.g., access-log-2026-01-13.xml)
  
  The batch processor will:
  1. Read this file at the scheduled time (e.g., 01:00 AM daily)
  2. Update each document's access statistics in the database
  3. Archive this file to prevent reprocessing
-->
<AccessLog date="2026-01-13">
  <Document id="1" accessCount="15" />
  <Document id="2" accessCount="8" />
  <Document id="3" accessCount="23" />
  <Document id="4" accessCount="5" />
  <Document id="5" accessCount="42" />
  <Document id="1" accessCount="7" /><!-- Multiple entries for same document are summed -->
</AccessLog>
