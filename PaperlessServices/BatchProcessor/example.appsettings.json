{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.Hosting.Lifetime": "Information",
            "BatchProcessor": "Debug"
        }
    },
    "ConnectionStrings": {
        "DefaultConnection": "<YOUR-CONNECTION-STRING>"
    },
    "BatchProcessor": {
        "Schedule": "0 1 * * *",
        "RunOnStartup": true,
        "InputFolder": "/data/input",
        "FilePattern": "access-log-*.xml",
        "ArchiveFolder": "/data/archive"
    }
}